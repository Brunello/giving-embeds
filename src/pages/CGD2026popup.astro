---
import Layout from "../layouts/Layout.astro";
import ColumbiaCrown from "../assets/columbia-crown.svg";
import { popupPhases, currentPhase } from "../campaigns/CGD2026";

const phase = currentPhase(popupPhases, Date.now());
---

<Layout title="Columbia Giving Day 2026 Popup">
    <main>
        <div class="popup-container">
            <div class="popup">
                <div class="popup-image">
                    <img src={ColumbiaCrown.src} />
                </div>
                <div class="popup-content">
                    <h2 id="headline">
                        {phase.headline.map((line, i) => <>{i > 0 && <br />}{line}</>)}
                    </h2>
                    <p id="supporting">
                        {phase.lead && <><strong>{phase.lead}</strong><br /></>}
                        {phase.body.map((line, i) => <>{i > 0 && <br />}{line}</>)}
                    </p>
                    <a
                        id="cta"
                        href={phase.link}
                        class="btn btn-primary"
                        target="_blank"
                    >{phase.cta}</a>
                </div>
                <div id="close" class="close">x</div>
            </div>
        </div>
    </main>
</Layout>

<style>
    html {
        background: transparent !important;
    }
    h2, p {
        margin: 0;
    }
    .popup-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .popup {
        position: relative;
        width: 100%;
        max-width: 745px;
        background-color: #fff;
        padding: 107px 56px 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        text-align: center;
    }
    .popup-image {
        max-width: 174px;
        position: absolute;
        top: 0;
        transform: translateY(-50%);
        background: white;
        border-radius: 50%;
        padding: 25px;
    }
    .popup-image img {
        width: 100%;
    }
    .popup-content {
        display: contents;
    }
    .popup-content h2 {
        font-size: 36px;
        line-height: 1.125;
        font-weight: 700;
        color: #1d4f91;
        letter-spacing: -0.75px;
        /* MAWM popup's 20px rather than Fall Appeal's 60px: the date headline
           is a single line, so there's no two-line break to balance. */
        padding: 0 20px 24px;
    }
    .popup-content p {
        font-size: 18px;
        font-weight: 300;
        line-height: 1.421;
        color: #000;
        padding-bottom: 32px;
    }
    .popup-content a {
        padding: 13px 29px;
        background-color: #fed302;
        color: #003373;
        font-size: 16px;
        text-decoration: none;
        font-weight: 700;
        border: 2px solid #fed302;
    }
    p strong {
        font-weight: 700;
    }
    #close {
        position: absolute;
        top: 0;
        right: 0;
        font-size: 20px;
        color: #fff;
        background: #2372b4;
        padding: 4.5px 11px;
        border-radius: 50%;
        cursor: pointer;
        transform: translate(50%, -50%);
    }
    @media (max-width: 767px) {
        .popup {
            max-width: calc(90vw - 48px);
            padding: 107px 24px 56px;
        }
        .popup-content h2 {
            font-size: 28px;
            padding: 0 0 14px;
        }
        .popup-content p {
            font-size: 16px;
        }
    }
</style>

<script>
    import { popupPhases, currentPhase, clock } from "../campaigns/CGD2026";

    const close = document.getElementById("close") as HTMLElement;
    const popupContainer = document.querySelector(
        ".popup-container"
    ) as HTMLElement;

    close.addEventListener("click", () => {
        popupContainer.style.display = "none";
        window.parent.postMessage("popup closed", "*");
    });

    const headline = document.getElementById("headline") as HTMLElement;
    const supporting = document.getElementById("supporting") as HTMLElement;
    const cta = document.getElementById("cta") as HTMLAnchorElement;

    // Fills el with one text line per entry, separated by <br>, optionally
    // led by a bold line.
    function setLines(el: HTMLElement, lines: string[], lead?: string) {
        el.replaceChildren();
        if (lead) {
            const strong = document.createElement("strong");
            strong.textContent = lead;
            el.append(strong, document.createElement("br"));
        }
        lines.forEach((line, i) => {
            if (i > 0) el.append(document.createElement("br"));
            el.append(line);
        });
    }

    const now = clock();
    let shown: (typeof popupPhases)[number] | undefined;

    // Re-picks the phase each second, so a popup left open swaps copy at the
    // boundary without a reload.
    function tick() {
        const phase = currentPhase(popupPhases, now());
        if (phase === shown) return;
        setLines(headline, phase.headline);
        setLines(supporting, phase.body, phase.lead);
        cta.textContent = phase.cta;
        cta.href = phase.link;
        shown = phase;
    }
    tick();
    setInterval(tick, 1000);
</script>
