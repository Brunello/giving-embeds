---
import Layout from "../layouts/Layout.astro";
import { bannerPhases, currentPhase } from "../campaigns/CGD2026";

const phase = currentPhase(bannerPhases, Date.now());
// Hidden once the phase's deadline has passed, rather than sitting at zero.
const showClock = Date.parse(phase.countdownTo) > Date.now();
---

<Layout title="Columbia Giving Day 2026 Banner">
    <main>
        <div class="banner-container">
            <div class="banner-content">
                <div id="countdown" class="countdown" style={showClock ? undefined : "display: none"}>
                    <span id="days">00D</span>
                    <span id="hours">00H</span>
                    <span id="minutes">00M</span>
                    <span id="seconds">00S</span>
                </div>
                <p id="message">{phase.message}</p>
            </div>
            <div class="cta-container">
                <a
                    id="cta"
                    class="cta"
                    href={phase.links.giving}
                    target="_blank"
                >
                    <span id="cta-text" class="cta-text">{phase.cta}</span>
                </a>
                <button id="close">X</button>
            </div>
        </div>
    </main>
</Layout>

<style>
    :root {
        --bg: #1d4f91;
        --text: #ffffff;
        --btn-bg: #fed302;
        --btn-color: #003373;
    }
    body {
        margin: 0;
        padding: 0;
    }
    .banner-container {
        background-color: var(--bg);
        color: var(--text);
        display: flex;
        justify-content: space-between;
        padding: 0 9%;
        width: calc(100% - 18%);
        gap: 14px;
    }
    .banner-container.closed {
        display: none;
    }
    .banner-content {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-shrink: 1;
        min-width: 0;
    }
    .countdown {
        display: flex;
        gap: 6px;
    }
    .countdown span {
        border: 2px solid #6dacde;
        background: #003373;
        padding: 5px 7px;
        font-weight: bold;
    }
    .banner-content p span {
        display: inline-block;
    }
    .cta-container {
        display: flex;
        align-items: center;
        gap: 35px;
        flex-shrink: 0;
    }
    .cta-container .cta {
        background-color: var(--btn-bg);
        color: var(--btn-color);
        padding: 10px 24px;
        font-size: 16px;
        text-decoration: none;
        font-weight: bold;
        font-family: proxima-nova, sans-serif;
        white-space: nowrap;
    }
    #close {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--bg);
        border: 1px solid var(--text);
        color: var(--text);
        font-size: 8px;
        padding-inline: 0;
        padding-top: 2px;
        cursor: pointer;
    }
    @media screen and (max-width: 990px) {
        .banner-container {
            padding: 1em 2em;
            width: calc(100% - 4em);
            flex-direction: column;
            justify-content: unset;
            align-items: center;
            gap: 1em;
        }
        .banner-content {
            flex-direction: column;
        }
        .banner-content p {
            margin: 0;
            text-align: center;
        }
        #close {
            position: absolute;
            top: 1.5em;
            right: 1.5em;
        }
        .cta-container {
            min-width: unset;
        }
    }
</style>

<script>
    import { bannerPhases, currentPhase, clock, type Site } from "../campaigns/CGD2026";

    const configs: Record<
        Site,
        { bg: string; text: string; btnBg: string; btnColor: string }
    > = {
        giving: {
            bg: "#1d4f91",
            text: "#ffffff",
            btnBg: "#fed302",
            btnColor: "#003373",
        },
        alumni: {
            bg: "#1d4f91",
            text: "#ffffff",
            btnBg: "#fed302",
            btnColor: "#003373",
        },
        magazine: {
            bg: "#395ea1",
            text: "#ffffff",
            btnBg: "#fed302",
            btnColor: "#003373",
        },
    };

    const param = new URLSearchParams(window.location.search).get("site");
    const site: Site = param && param in configs ? (param as Site) : "giving";
    const config = configs[site];

    const root = document.documentElement;
    root.style.setProperty("--bg", config.bg);
    root.style.setProperty("--text", config.text);
    root.style.setProperty("--btn-bg", config.btnBg);
    root.style.setProperty("--btn-color", config.btnColor);

    const close = document.getElementById("close") as HTMLElement;
    close.addEventListener("click", () => {
        window.parent.postMessage("banner closed", "*");
    });

    const message = document.getElementById("message") as HTMLElement;
    const cta = document.getElementById("cta") as HTMLAnchorElement;
    const ctaText = document.getElementById("cta-text") as HTMLElement;
    const countdown = document.getElementById("countdown") as HTMLElement;
    const daysElement = document.getElementById("days") as HTMLElement;
    const hoursElement = document.getElementById("hours") as HTMLElement;
    const minutesElement = document.getElementById("minutes") as HTMLElement;
    const secondsElement = document.getElementById("seconds") as HTMLElement;

    var _second = 1000;
    var _minute = _second * 60;
    var _hour = _minute * 60;
    var _day = _hour * 24;

    const now = clock();
    let shown: (typeof bannerPhases)[number] | undefined;

    // Re-picks the phase each second, so an open page swaps copy at the
    // boundary, then updates the countdown to that phase's deadline.
    function tick() {
        const t = now();
        const phase = currentPhase(bannerPhases, t);
        if (phase !== shown) {
            message.textContent = phase.message;
            ctaText.textContent = phase.cta;
            cta.href = phase.links[site];
            shown = phase;
        }

        var distance = Math.max(0, Date.parse(phase.countdownTo) - t);
        // Hide the clock rather than show zeros, e.g. between the pre-day
        // deadline and the Giving Day switch.
        countdown.style.display = distance > 0 ? "" : "none";
        var days = Math.floor(distance / _day);
        var hours = Math.floor((distance % _day) / _hour);
        var minutes = Math.floor((distance % _hour) / _minute);
        var seconds = Math.floor((distance % _minute) / _second);

        daysElement.innerHTML = days + "D";
        hoursElement.innerHTML = hours + "H";
        minutesElement.innerHTML = minutes + "M";
        secondsElement.innerHTML = seconds + "S";
    }
    tick();
    setInterval(tick, 1000);

    function postHeight() {
        window.parent.postMessage(
            { type: "resize", height: document.body.scrollHeight },
            "*"
        );
    }

    const observer = new ResizeObserver(postHeight);
    observer.observe(document.body);
</script>
