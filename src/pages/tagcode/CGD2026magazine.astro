<script type="text/javascript">
    if (!document.cookie.includes("cgd_banner_closed=1")) {
        var iframe = document.createElement("iframe");
        iframe.src = "https://giving-embeds.vercel.app/CGD2026?site=magazine";
        iframe.setAttribute("id", "cgd-banner");
        document.body.insertBefore(iframe, document.body.firstChild);

        window.addEventListener("message", function (event) {
            if (event.data && event.data.type === "resize") {
                var h = event.data.height + "px";
                var banner = document.getElementById("cgd-banner");
                if (banner) {
                    banner.style.height = h;
                    document.documentElement.style.setProperty("--cgd-banner-height", h);
                }
            }
            if (event.data === "banner closed") {
                var date = new Date(Date.now() + 86400 * 1000).toUTCString();
                var banner = document.getElementById("cgd-banner");
                banner.parentNode.removeChild(banner);
                document.cookie =
                    "cgd_banner_closed=1; expires=" + date + "; max-age=86400;";
            }
        });
    }
</script>
<style>
    #cgd-banner {
        width: 100%;
        height: 0;
        border: 0;
        position: fixed;
        top: 0;
        z-index: 101;
    }
    body:has(#cgd-banner) #header {
        top: var(--cgd-banner-height, 0px);
    }
    body:has(#cgd-banner) main {
        padding-top: var(--cgd-banner-height, 0px);
    }
</style>
